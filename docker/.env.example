# Chave usada no header "apikey" nas requisições à Evolution API.
# Use a mesma valor em EVOLUTION_API_KEY no .env do Laravel (nexxivo).
EVOLUTION_API_KEY=sua-chave-aqui

# URL que a Evolution (container) usa para enviar webhooks ao Laravel.
#
# DESENVOLVIMENTO LOCAL (Evolution no Docker, Laravel na sua máquina):
#   A Evolution precisa "enxergar" sua máquina. Use ngrok:
#   1. Rode: ngrok http 8000
#   2. Copie a URL HTTPS (ex.: https://abc123.ngrok-free.app)
#   3. Defina aqui: WEBHOOK_GLOBAL_URL=https://abc123.ngrok-free.app/api/webhooks/evolution
#   4. No .env do nexxivo: EVOLUTION_WEBHOOK_URL=https://abc123.ngrok-free.app
#
# MESMO HOST (Laravel e Evolution no mesmo servidor/Docker):
#   Use a rede interna, ex.: http://laravel-app/api/webhooks/evolution
#
# FALLBACK (Laravel na porta 8000 acessível pelo host):
#   WEBHOOK_GLOBAL_URL=http://host.docker.internal:8000/api/webhooks/evolution
WEBHOOK_GLOBAL_URL=http://host.docker.internal:8000/api/webhooks/evolution

# No docker-compose: CONFIG_SESSION_PHONE_VERSION=2.3000.1018917897 (ou 2.2432.5.0 / 2.3000.1015901307)

# PostgreSQL (usado pela Evolution API v2)
POSTGRES_USER=evolution
POSTGRES_PASSWORD=evolution
POSTGRES_DB=evolution
